#!/usr/bin/env python3
"""
USBAnywhere Control Suite (macOS & Linux)
Unified management, interactive dashboard, and diagnostic tool for USBAnywhere Server.
Uses the Python 3 standard library on macOS and Linux; the native Mac app needs no Python.

Copyright (c) 2025-2026 oscarlosu-lab - https://github.com/oscarlosu-lab/USBAnywhere-Server
Native macOS integration: Denis Arnst (Sapd) — https://github.com/Sapd
Licensed under GPL v3
"""
import os
import sys
import platform
import subprocess
import socket
import struct
import time
import json
import shutil
import re
import argparse

if hasattr(sys.stdout, "reconfigure"):
    sys.stdout.reconfigure(encoding="utf-8")
if hasattr(sys.stderr, "reconfigure"):
    sys.stderr.reconfigure(encoding="utf-8")

VERSION = "3.0.1"
PORT = 3240

IS_MACOS = platform.system() == "Darwin"
IS_LINUX = platform.system() == "Linux"
MAC_LABEL = "local.usbanywhere.macos"
MAC_PLIST = "/Library/LaunchDaemons/" + MAC_LABEL + ".plist"
MAC_HELPER = "/Library/PrivilegedHelperTools/USBAnywhereMac/usbanywhere-mac"
MAC_LOG = "/Library/Logs/USBAnywhereMac/swift-server.log"


def mac_control(action="status", busid=None):
    """Use the native client so socket ownership and peer checks stay in Swift."""
    if not os.path.isfile(MAC_HELPER):
        raise RuntimeError("Open USBAnywhere.app and complete Set Up Sharing first")
    command = [MAC_HELPER, "--control", action]
    if busid is not None:
        if not re.fullmatch(r"1-(?:[1-9]|1[0-6])", busid):
            raise RuntimeError("Choose a remembered bus ID from 1-1 through 1-16")
        command.append(busid)
    try:
        result = subprocess.run(command, capture_output=True, text=True, timeout=10)
        reply = json.loads(result.stdout)
    except (OSError, ValueError, subprocess.TimeoutExpired) as error:
        raise RuntimeError("Could not reach the native sharing service: " + str(error)) from error
    if not isinstance(reply, dict):
        raise RuntimeError("Invalid native service response")
    if result.returncode != 0 or reply.get("ok") is not True:
        raise RuntimeError(reply.get("message") or result.stderr.strip() or "Native sharing request failed")
    if action == "status":
        state = reply.get("status")
        if not isinstance(state, dict) or not isinstance(state.get("devices"), list) or not state.get("listen"):
            raise RuntimeError("Invalid native status response")
    return reply


def mac_service(action):
    """Manage only our registered service; never spawn a second forwarding daemon."""
    try:
        if not is_root():
            result = subprocess.run(["sudo", sys.executable, os.path.realpath(__file__), action])
            return result.returncode == 0
        if not os.path.isfile(MAC_PLIST):
            raise RuntimeError("Open USBAnywhere.app and complete Set Up Sharing first")
        target = "system/" + MAC_LABEL
        if action == "stop":
            loaded = subprocess.run(["launchctl", "print", target], capture_output=True, text=True, timeout=10)
            if loaded.returncode == 113:
                print("Native macOS service is already stopped.")
                return True
            loaded.check_returncode()
            subprocess.run(["launchctl", "bootout", target], capture_output=True, text=True,
                           timeout=20, check=True)
        else:
            loaded = subprocess.run(["launchctl", "print", target], capture_output=True, text=True, timeout=10)
            subprocess.run(["launchctl", "enable", target], capture_output=True, text=True, timeout=10, check=True)
            if loaded.returncode != 0:
                subprocess.run(["launchctl", "bootstrap", "system", MAC_PLIST], capture_output=True,
                               text=True, timeout=20, check=True)
            # Start an idle registered service, or explicitly restart the running one.
            command = ["launchctl", "kickstart"] + (["-k"] if action == "restart" else []) + [target]
            subprocess.run(command, capture_output=True, text=True, timeout=20, check=True)
        print("Native macOS service " + action + " completed.")
        return True
    except (OSError, RuntimeError, subprocess.SubprocessError) as error:
        print("Service action failed: " + str(error), file=sys.stderr)
        return False


def mac_device_action(action, busid):
    try:
        reply = mac_control(action, busid)
        print(reply.get("message") or "Sharing updated")
        return True
    except RuntimeError as error:
        print(str(error), file=sys.stderr)
        return False


def show_logs(follow=False):
    if IS_MACOS:
        command = ["tail", "-f", MAC_LOG] if follow else ["tail", "-n", "30", MAC_LOG]
    elif IS_LINUX:
        command = ["journalctl", "-u", "usbipd", "-f"] if follow else ["journalctl", "-u", "usbipd", "-n", "30", "--no-pager"]
    else:
        return False
    try:
        return subprocess.run(command).returncode == 0
    except OSError as error:
        print(str(error), file=sys.stderr)
        return False

# Terminal ANSI styling
GREEN = "\033[92m"
BLUE = "\033[94m"
CYAN = "\033[96m"
YELLOW = "\033[93m"
RED = "\033[91m"
BOLD = "\033[1m"
DIM = "\033[2m"
RESET = "\033[0m"

# ══════════════════════════════════════════════════════════════════════════════
# HELPER UTILITIES
# ══════════════════════════════════════════════════════════════════════════════

def run_cmd(cmd, capture=True, check=False):
    """Run shell command safely without shell injection."""
    try:
        res = subprocess.run(cmd, stdout=subprocess.PIPE if capture else None,
                             stderr=subprocess.PIPE if capture else None,
                             text=True, check=check)
        return res.stdout.strip() if capture else ""
    except Exception as e:
        if check:
            raise
        return ""

def is_root():
    """Check if script is running with superuser privileges."""
    return os.geteuid() == 0 if hasattr(os, "geteuid") else False

def get_lan_ip():
    """Find local LAN IPv4 address."""
    try:
        s = socket.socket(socket.AF_INET, socket.SOCK_DGRAM)
        s.connect(("8.8.8.8", 80))
        ip = s.getsockname()[0]
        s.close()
        return ip
    except Exception:
        return "127.0.0.1"

def is_port_open(host="127.0.0.1", port=PORT, timeout=1.0):
    """Check if USB/IP daemon is listening on TCP port."""
    try:
        s = socket.socket(socket.AF_INET, socket.SOCK_STREAM)
        s.settimeout(timeout)
        res = s.connect_ex((host, port))
        s.close()
        return res == 0
    except Exception:
        return False

# ══════════════════════════════════════════════════════════════════════════════
# SERVICE CONTROLLERS (macOS launchd vs Linux systemd)
# ══════════════════════════════════════════════════════════════════════════════

def get_service_status():
    """Check background daemon status."""
    if IS_MACOS:
        status = {"os": "macOS", "service_manager": "launchd",
                  "installed": os.path.isfile(MAC_PLIST), "running": False,
                  "port_active": False, "devices": []}
        try:
            native = mac_control()["status"]
            status.update(native)
            status.update(running=True, port_active=is_port_open(native["listen"]),
                          lan_ip=native["listen"])
        except RuntimeError as error:
            status["error"] = str(error)
        return status
    elif IS_LINUX:
        port_active = is_port_open()
        installed = os.path.exists("/etc/systemd/system/usbipd.service") or \
                    os.path.exists("/lib/systemd/system/usbipd.service")
        out = run_cmd(["systemctl", "is-active", "usbipd"])
        running = out == "active"
        return {
            "os": "Linux",
            "service_manager": "systemd",
            "installed": installed,
            "running": running or port_active,
            "port_active": port_active
        }
    else:
        return {
            "os": platform.system(),
            "service_manager": "unknown",
            "installed": False,
            "running": is_port_open(),
            "port_active": is_port_open()
        }

def start_service():
    """Start the USB/IP server service."""
    if IS_MACOS:
        return mac_service("start")
    if not is_root():
        print(f"{YELLOW}[!] Superuser privileges required. Re-running with sudo...{RESET}")
        return os.system(f"sudo {sys.executable} {' '.join(sys.argv)}") == 0

    if IS_LINUX:
        run_cmd(["systemctl", "restart", "usbipd"])
        print(f"{GREEN}✓ Linux service started via systemd.{RESET}")
        return True
    return False

def stop_service():
    """Stop the USB/IP server service."""
    if IS_MACOS:
        return mac_service("stop")
    if not is_root():
        print(f"{YELLOW}[!] Superuser privileges required. Re-running with sudo...{RESET}")
        return os.system(f"sudo {sys.executable} {' '.join(sys.argv)}") == 0

    if IS_LINUX:
        run_cmd(["systemctl", "stop", "usbipd"])
        run_cmd(["pkill", "-f", "usbipd"])
        print(f"{GREEN}✓ Linux service stopped.{RESET}")
        return True
    return False

# ══════════════════════════════════════════════════════════════════════════════
# DEVICE INVENTORY (IOKit vs usbip / sysfs)
# ══════════════════════════════════════════════════════════════════════════════

def list_devices():
    """List local physical USB peripherals."""
    devices = []
    if IS_MACOS:
        try:
            state = mac_control()["status"]
            for item in state["devices"]:
                devices.append("[{}] {} ({}) — {}".format(item["id"], item["name"], item["model"], item["state"]))
            for item in state.get("availableDevices", []):
                devices.append("[unconfigured {}] {} ({}:{}) — Share in USBAnywhere.app".format(
                    item["location"], item["name"], item["vendor"], item["product"]))
        except RuntimeError:
            # Inventory remains available before first service setup.
            for line in run_cmd(["system_profiler", "SPUSBDataType"]).splitlines():
                if "Product ID:" in line:
                    devices.append(line.strip())
    elif IS_LINUX:
        bin_path = shutil.which("usbip")
        if bin_path:
            out = run_cmd([bin_path, "list", "-l"])
            curr_bus = None
            for line in out.splitlines():
                if "busid" in line:
                    m = re.search(r"busid\s+([0-9a-zA-Z\-\.]+)\s+\((.*?)\)", line)
                    if m:
                        curr_bus = m.group(1)
                        desc = m.group(2)
                        devices.append(f"[{curr_bus}] {desc}")
        else:
            out = run_cmd(["lsusb"])
            for line in out.splitlines():
                if line.strip():
                    devices.append(line.strip())
    return devices

def share_device(busid):
    """Export a specific USB peripheral by bus ID."""
    if IS_MACOS:
        return mac_device_action("share", busid)
    if not is_root():
        print(f"{YELLOW}[!] Superuser privileges required. Re-running with sudo...{RESET}")
        return os.system(f"sudo {sys.executable} {' '.join(sys.argv)}") == 0

    if IS_LINUX:
        bin_path = shutil.which("usbip")
        if bin_path:
            out = run_cmd([bin_path, "bind", "-b", busid])
            print(out or f"{GREEN}✓ Device {busid} bound via usbip.{RESET}")
            return True
    return False

def unshare_device(busid):
    """Unshare a USB peripheral by bus ID."""
    if IS_MACOS:
        return mac_device_action("unshare", busid)
    if not is_root():
        print(f"{YELLOW}[!] Superuser privileges required. Re-running with sudo...{RESET}")
        return os.system(f"sudo {sys.executable} {' '.join(sys.argv)}") == 0

    if IS_LINUX:
        bin_path = shutil.which("usbip")
        if bin_path:
            out = run_cmd([bin_path, "unbind", "-b", busid])
            print(out or f"{GREEN}✓ Device {busid} unbound via usbip.{RESET}")
            return True
    return False

# ══════════════════════════════════════════════════════════════════════════════
# DIAGNOSTICS & SELF-TEST
# ══════════════════════════════════════════════════════════════════════════════

def run_self_test(host=None, port=PORT):
    """Run binary loopback protocol handshake test."""
    if IS_MACOS and host is None:
        try:
            state = mac_control()["status"]
            print("Native local-control self-test passed: {} remembered devices.".format(len(state["devices"])))
            print("Run the USB/IP network probe from the allowed Windows peer {} to {}:{}; this Mac is not an allowed network client.".format(state.get("peer", ""), state["listen"], port))
            return True
        except RuntimeError as error:
            print(str(error), file=sys.stderr)
            return False
    host = host or "127.0.0.1"
    print(f"\n{CYAN}═══ 🧪 USBAnywhere Binary Protocol Self-Test ═══{RESET}")
    print(f"Connecting to {host}:{port}...")

    s = None
    for attempt in range(1, 4):
        try:
            s = socket.socket(socket.AF_INET, socket.SOCK_STREAM)
            s.settimeout(3.0)
            s.connect((host, port))
            print(f"{GREEN}✓ TCP Connection established on port {port}{RESET}")
            break
        except Exception as e:
            if s:
                s.close()
            s = None
            time.sleep(0.5)
            if attempt == 3:
                print(f"{RED}✗ FAILED: Could not connect to port {port} ({e}){RESET}")
                return False

    try:
        # Send OP_REQ_DEVLIST (0x0111, 0x8005, 0x00000000)
        req = struct.pack(">HHI", 0x0111, 0x8005, 0)
        s.sendall(req)

        def exact(length):
            data = b""
            while len(data) < length:
                chunk = s.recv(length - len(data))
                if not chunk:
                    raise EOFError("Truncated USB/IP reply")
                data += chunk
            return data
        header = exact(8)
        if len(header) < 8:
            print(f"{RED}✗ FAILED: Expected 8 header bytes, received {len(header)}{RESET}")
            s.close()
            return False

        version, cmd, status = struct.unpack(">HHI", header)
        print(f"Received Header: Version=0x{version:04X}, Cmd=0x{cmd:04X}, Status={status}")

        if version == 0x0111 and cmd == 0x0005 and status == 0:
            ndev = struct.unpack(">I", exact(4))[0]
            print(f"{GREEN}✓ USB/IP OP_REP_DEVLIST valid! Exported devices: {ndev}{RESET}")
            s.close()
            print(f"{GREEN}✓ PROTOCOL SELF-TEST PASSED: Server is fully operational!{RESET}\n")
            return True
        else:
            print(f"{RED}✗ FAILED: Protocol header mismatch.{RESET}")
            s.close()
            return False
    except Exception as e:
        print(f"{RED}✗ FAILED with exception: {e}{RESET}")
        if s: s.close()
        return False

def run_doctor():
    """System health check and diagnostic inspection."""
    print(f"\n{BOLD}{CYAN}═══ 🩺 USBAnywhere System Doctor ═══{RESET}\n")

    # 1. OS & Kernel
    os_name = platform.system()
    arch = platform.machine()
    print(f"• Operating System:   {BOLD}{os_name} ({arch}){RESET}")
    print(f"• Kernel Version:     {platform.release()}")

    # 2. Permissions
    root = is_root()
    root_str = f"{GREEN}YES (root){RESET}" if root else f"{YELLOW}NO (standard user){RESET}"
    print(f"• Superuser Privs:    {root_str}")

    # 3. Port & Service
    st = get_service_status()
    if st.get("error"):
        print("• Service Detail:     " + st["error"])
    srv_str = f"{GREEN}ACTIVE{RESET}" if st["running"] else f"{RED}STOPPED{RESET}"
    port_str = f"{GREEN}LISTENING (Port {PORT}){RESET}" if st["port_active"] else f"{RED}CLOSED{RESET}"
    print(f"• Service Status:     {srv_str} (via {st['service_manager']})")
    print(f"• Network Listener:   {port_str}")
    print(f"• Server IPv4:        {CYAN}{st.get('listen') or get_lan_ip()}{RESET}")

    # 4. Kernel Modules (Linux only)
    if IS_LINUX:
        lsmod = run_cmd(["lsmod"])
        has_core = "usbip_core" in lsmod
        has_host = "usbip_host" in lsmod
        core_str = f"{GREEN}LOADED{RESET}" if has_core else f"{RED}MISSING (run: sudo modprobe usbip_core){RESET}"
        host_str = f"{GREEN}LOADED{RESET}" if has_host else f"{RED}MISSING (run: sudo modprobe usbip_host){RESET}"
        print(f"• Kernel Module core: {core_str}")
        print(f"• Kernel Module host: {host_str}")

    # 5. Device Inventory
    devs = list_devices()
    print(f"• USB Devices Found:  {BOLD}{len(devs)}{RESET}")
    for d in devs[:5]:
        print(f"    {DIM}{d}{RESET}")
    if len(devs) > 5:
        print(f"    {DIM}... and {len(devs) - 5} more{RESET}")

    print(f"\n{GREEN}Doctor completed.{RESET}\n")

# ══════════════════════════════════════════════════════════════════════════════
# INTERACTIVE DASHBOARD / TUI
# ══════════════════════════════════════════════════════════════════════════════

def render_dashboard():
    """Interactive Control Suite Terminal Dashboard."""
    while True:
        # Clear screen
        os.system("clear" if os.name != "nt" else "cls")

        st = get_service_status()
        lan_ip = st.get("listen") or get_lan_ip()
        devs = list_devices()

        status_badge = f"{GREEN}● ACTIVE{RESET}" if st["running"] else f"{RED}○ STOPPED{RESET}"
        port_badge = f"{GREEN}OPEN (Port {PORT}){RESET}" if st["port_active"] else f"{RED}CLOSED{RESET}"

        print(f"""
{CYAN}╔══════════════════════════════════════════════════════════════════════════════╗
║                 🎛️  {BOLD}USBAnywhere Control Suite v{VERSION}{RESET}{CYAN}                           ║
║   Share local USB peripherals over network (Moonlight/Sunshine/Sim/Work)     ║
╚══════════════════════════════════════════════════════════════════════════════╝{RESET}
  • {BOLD}OS:{RESET} {st['os']}
  • {BOLD}Server Daemon:{RESET} {status_badge}  |  {BOLD}Port 3240:{RESET} {port_badge}
  • {BOLD}Server IP (LAN):{RESET} {BOLD}{GREEN}{lan_ip}{RESET}  (Enter this IP in USBAnywhere Windows Client)
  • {BOLD}Service Manager:{RESET} {st['service_manager']}

{BOLD}📋 Discovered Physical USB Peripherals ({len(devs)}):{RESET}""")

        if not devs:
            print(f"  {YELLOW}No USB devices discovered or permission required.{RESET}")
        else:
            for idx, d in enumerate(devs[:8], start=1):
                print(f"  {BOLD}[{idx}]{RESET} {d}")
            if len(devs) > 8:
                print(f"  {DIM}... ({len(devs) - 8} more devices){RESET}")

        print(f"""
{CYAN}═══════════════════════════════ CONTROL ACTIONS ═══════════════════════════════{RESET}
  {BOLD}[1]{RESET} Start / Restart Service       {BOLD}[5]{RESET} Run Health Doctor
  {BOLD}[2]{RESET} Stop Service                  {BOLD}[6]{RESET} Run Protocol Self-Test
  {BOLD}[3]{RESET} Share a USB Device            {BOLD}[7]{RESET} View Live Logs
  {BOLD}[4]{RESET} Unshare a USB Device          {BOLD}[8]{RESET} Refresh Dashboard
  {BOLD}[q]{RESET} Quit Control Suite
""")

        choice = input(f"{BOLD}Select an action [1-8, q]: {RESET}").strip().lower()

        if choice == "1":
            start_service()
            time.sleep(2)
        elif choice == "2":
            stop_service()
            time.sleep(1.5)
        elif choice == "3":
            bus = input("Enter USB Bus ID to share (e.g. 1-1): ").strip()
            if bus:
                share_device(bus)
                time.sleep(2)
        elif choice == "4":
            bus = input("Enter USB Bus ID to unshare: ").strip()
            if bus:
                unshare_device(bus)
                time.sleep(2)
        elif choice == "5":
            run_doctor()
            input(f"\n{DIM}Press Enter to return to Dashboard...{RESET}")
        elif choice == "6":
            run_self_test()
            input(f"\n{DIM}Press Enter to return to Dashboard...{RESET}")
        elif choice == "7":
            show_logs()
            input(f"\n{DIM}Press Enter to return to Dashboard...{RESET}")
        elif choice == "8" or choice == "":
            continue
        elif choice in ["q", "quit", "exit"]:
            print(f"\n{GREEN}Exiting USBAnywhere Control Suite. Have a great day!{RESET}\n")
            break

# ══════════════════════════════════════════════════════════════════════════════
# MAIN DISPATCHER
# ══════════════════════════════════════════════════════════════════════════════

def main():
    parser = argparse.ArgumentParser(
        description=f"USBAnywhere Control Suite v{VERSION} — macOS & Linux",
        epilog="Run without arguments to launch interactive Control Dashboard."
    )
    parser.add_argument("command", nargs="?", default="dashboard",
                        choices=["dashboard", "status", "start", "stop", "restart",
                                 "list", "share", "unshare", "reconnect", "doctor", "test", "logs"],
                        help="Action to perform (default: interactive dashboard)")
    parser.add_argument("busid", nargs="?", default=None, help="Target USB bus ID for share/unshare")
    parser.add_argument("--json", action="store_true", help="Output status in JSON format")

    parser.add_argument("--host", help="Explicit remote host for the USB/IP network self-test")
    parser.add_argument("--port", type=int, default=PORT, help="USB/IP test port (default 3240)")
    args = parser.parse_args()

    if args.command == "dashboard":
        render_dashboard()
    elif args.command == "status":
        st = get_service_status()
        if "lan_ip" not in st:
            st["lan_ip"] = get_lan_ip()
        if not IS_MACOS:
            st["devices"] = list_devices()
        if args.json:
            print(json.dumps(st, indent=2))
        else:
            status_str = f"{GREEN}ACTIVE{RESET}" if st["running"] else f"{RED}STOPPED{RESET}"
            print(f"USBAnywhere Server: {status_str} (via {st['service_manager']})")
            print(f"Port 3240:         {GREEN}OPEN{RESET}" if st["port_active"] else f"Port 3240: {RED}CLOSED{RESET}")
            print(f"LAN IP:            {st['lan_ip']}")
            print(f"Devices detected:  {len(st['devices'])}")
    elif args.command == "start":
        sys.exit(0 if start_service() else 1)
    elif args.command == "stop":
        sys.exit(0 if stop_service() else 1)
    elif args.command == "restart":
        if IS_MACOS:
            sys.exit(0 if mac_service("restart") else 1)
        if not stop_service():
            sys.exit(1)
        time.sleep(1)
        sys.exit(0 if start_service() else 1)
    elif args.command == "list":
        devs = list_devices()
        print(f"Discovered USB Peripherals ({len(devs)}):")
        for d in devs:
            print(f"  {d}")
    elif args.command == "share":
        if not args.busid:
            print(f"{RED}Error: Missing bus ID. Usage: usbanywhere-ctl share <busid>{RESET}")
            sys.exit(1)
        sys.exit(0 if share_device(args.busid) else 1)
    elif args.command == "unshare":
        if not args.busid:
            print(f"{RED}Error: Missing bus ID. Usage: usbanywhere-ctl unshare <busid>{RESET}")
            sys.exit(1)
        sys.exit(0 if unshare_device(args.busid) else 1)
    elif args.command == "reconnect":
        if not IS_MACOS or not args.busid:
            parser.error("reconnect requires macOS and a remembered bus ID")
        sys.exit(0 if mac_device_action("reconnect", args.busid) else 1)
    elif args.command == "doctor":
        run_doctor()
    elif args.command == "test":
        ok = run_self_test(args.host, args.port)
        sys.exit(0 if ok else 1)
    elif args.command == "logs":
        sys.exit(0 if show_logs(follow=True) else 1)

if __name__ == "__main__":
    main()
